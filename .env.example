# PineappleFX backend configuration
#
# Copy to `.env` and fill in, or set these as real environment variables
# (preferred in production — `.env` is gitignored):
#
#   cp .env.example .env
#
# Then run:  node server.js
# Check:     http://localhost:8787/api/health   → "ready": true

# ---------------------------------------------------------------- required ---

# License signing secret. MUST equal SECRET in tools/mint_key.py and the secret
# compiled into the shipped .zxp panel. Rotating it invalidates every key that
# was already issued and requires reshipping the extension.
MINT_SECRET=

# PayPal REST app credentials (developer.paypal.com → Apps & Credentials).
# Live app for production; sandbox app + PAYPAL_ENV=sandbox for testing.
# Without these, every paid checkout fails closed with 503 server-misconfigured.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "live" (default) or "sandbox"
PAYPAL_ENV=live

# ---------------------------------------------------------------- optional ---

# Persistent storage directory for pfx-db.json (users, licenses, coupons,
# orders). Must point at a real disk — NOT a serverless ephemeral filesystem.
# Default: ./data
DATA_DIR=

# JWT signing secret for admin sessions. Defaults to MINT_SECRET.
TOKEN_SECRET=

# Admin account email. This address is granted admin on signup.
# Default: pineapplefx.store@gmail.com
ADMIN_EMAIL=

# Key delivery email (Resend preferred, SendGrid fallback). Optional — without
# a mailer the key is still shown on screen and stored in /dashboard.
RESEND_API_KEY=
SENDGRID_API_KEY=
MAIL_FROM="PineappleFX <keys@example.com>"

# Public download link included in the delivery email.
DOWNLOAD_URL=https://www.pineapplestore.us.ci/downloads/PineappleFX.zxp

# Extra allowed CORS origins, comma separated. The shop origins are built in.
ALLOWED_ORIGINS=

# Extra coupon codes for the API, JSON: {"CODE":"percent:25","FREEBIE":"free"}.
# Codes created in the admin panel live in the database instead.
COUPON_ALLOWLIST=

# Server port / bind address (server.js only).
PORT=8787
HOST=0.0.0.0

# ------------------------------------------------------------ DANGER ZONE ---

# Skip PayPal order verification. LOCAL DEV / CI ONLY.
# With this set, any string is accepted as payment proof — never enable it on a
# public deployment, or anyone can mint free keys.
# PFX_ALLOW_UNVERIFIED=1
