<?xml version="1.0" encoding="UTF-8"?>
<!--
  PineappleFX — CEP panel manifest.
  Targets After Effects 22.0+ (host id "AEFT"), which corresponds to CEP 11.
-->
<ExtensionManifest Version="11.0" ExtensionBundleId="com.pineapplestore.pineapplefx"
                   ExtensionBundleVersion="2.0.0"
                   ExtensionBundleName="PineappleFX"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Author>Pineapple Store</Author>

  <ExtensionList>
    <Extension Id="com.pineapplestore.pineapplefx.panel" Version="2.0.0" />
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[22.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="com.pineapplestore.pineapplefx.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./dist/index.html</MainPath>
          <ScriptPath>./extendscript/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>PineappleFX</Menu>
          <Geometry>
            <Size>
              <Height>720</Height>
              <Width>640</Width>
            </Size>
            <MinSize>
              <Height>520</Height>
              <Width>520</Width>
            </MinSize>
            <MaxSize>
              <Height>1600</Height>
              <Width>1200</Width>
            </MaxSize>
          </Geometry>
          <Icons />
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
